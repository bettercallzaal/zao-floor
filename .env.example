# ZAO Floor environment configuration
# Copy this file to .env and fill in your actual values
# NEVER commit .env to the repository

# Supabase ZAOcowork project (for board read integration in Phase 2)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here

# Claude API (if using Claude agents)
# ANTHROPIC_API_KEY=sk-ant-...

# Groq (if using voice via Groq Whisper)
# GROQ_API_KEY=gsk_...

# OpenAI (if using OpenAI Codex provider)
# OPENAI_API_KEY=sk-...

# xAI Grok (if using Grok provider)
# XAI_API_KEY=...

# Gemini / Antigravity (if using Gemini provider)
# GOOGLE_API_KEY=...

# GitHub (if using GitHub Copilot CLI)
# GITHUB_TOKEN=ghp_...

# LocalTunnel token for remote access (optional)
# LOCALTUNNEL_TOKEN=...
